<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MultiCalc Universal</title>
  <style>
    :root {
      --bg-dark: #070913;
      --card-bg: rgba(15, 23, 42, 0.65);
      --card-border: rgba(255, 255, 255, 0.12);
      --accent-cyan: #06b6d4;
      --accent-purple: #a855f7;
      --accent-pink: #ec4899;
      --physics-color: #d946ef; /* Exclusive Electric Violet for Physics */
      --cs-color: #3b82f6;      /* Electric Blue for Computer Science */
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      user-select: none;
      -webkit-user-select: none;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      overflow-x: hidden;
      padding: 20px 10px;
      position: relative;
    }

    /* Cosmic Background Canvas */
    #bg-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -1;
      pointer-events: none;
    }

    /* Main Container */
    .app-container {
      width: 100%;
      max-width: 950px;
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.1);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* Header */
    header {
      padding: 18px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--card-border);
      background: rgba(255, 255, 255, 0.03);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-title {
      font-size: 1.4rem;
      font-weight: 700;
      background: linear-gradient(135deg, var(--accent-cyan), var(--physics-color));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .author-tag {
      font-size: 0.8rem;
      background: rgba(255, 255, 255, 0.08);
      padding: 4px 10px;
      border-radius: 20px;
      color: var(--text-muted);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .header-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .btn-icon {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: var(--text-main);
      padding: 8px 14px;
      border-radius: 12px;
      cursor: pointer;
      font-size: 0.9rem;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-icon:hover {
      background: rgba(255, 255, 255, 0.18);
      transform: translateY(-1px);
    }

    .btn-complain {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(220, 38, 38, 0.4));
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #fca5a5;
    }

    .btn-complain:hover {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.4), rgba(220, 38, 38, 0.6));
      color: #fff;
    }

    /* Navigation Tabs */
    .tab-nav {
      display: flex;
      overflow-x: auto;
      padding: 12px 18px;
      gap: 8px;
      border-bottom: 1px solid var(--card-border);
      scrollbar-width: none;
    }

    .tab-nav::-webkit-scrollbar {
      display: none;
    }

    .tab-btn {
      padding: 10px 18px;
      border-radius: 12px;
      border: 1px solid transparent;
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.25s ease;
    }

    .tab-btn:hover {
      background: rgba(255, 255, 255, 0.08);
      color: var(--text-main);
    }

    .tab-btn.active {
      background: rgba(6, 182, 212, 0.15);
      border-color: var(--accent-cyan);
      color: var(--accent-cyan);
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.3);
    }

    /* EXCLUSIVE PHYSICS TAB STYLING */
    .tab-btn[data-tab="physics"] {
      border-color: rgba(217, 70, 239, 0.3);
      color: #e879f9;
    }

    .tab-btn[data-tab="physics"]:hover {
      background: rgba(217, 70, 239, 0.15);
    }

    .tab-btn[data-tab="physics"].active {
      background: rgba(217, 70, 239, 0.25) !important;
      border-color: var(--physics-color) !important;
      color: #f5d0fe !important;
      box-shadow: 0 0 20px rgba(217, 70, 239, 0.5) !important;
    }

    /* CS TAB STYLING */
    .tab-btn[data-tab="cs"].active {
      background: rgba(59, 130, 246, 0.25);
      border-color: var(--cs-color);
      color: #93c5fd;
      box-shadow: 0 0 15px rgba(59, 130, 246, 0.4);
    }

    /* Content Panels */
    .tab-panel {
      display: none;
      padding: 24px;
    }

    .tab-panel.active {
      display: block;
      animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Display Screen */
    .calc-screen {
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 20px;
      text-align: right;
    }

    .calc-history-text {
      font-size: 0.95rem;
      color: var(--text-muted);
      min-height: 22px;
      word-wrap: break-word;
    }

    .calc-main-text {
      font-size: 2.5rem;
      font-weight: 700;
      color: #fff;
      word-wrap: break-word;
      margin-top: 6px;
    }

    /* Grid Layouts */
    .calc-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
    }

    .btn-calc {
      padding: 16px;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-main);
      cursor: pointer;
      transition: all 0.15s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .btn-calc:hover {
      background: rgba(255, 255, 255, 0.12);
      transform: translateY(-2px);
    }

    .btn-calc:active {
      transform: translateY(0);
    }

    .btn-op {
      background: rgba(6, 182, 212, 0.12);
      color: var(--accent-cyan);
      border-color: rgba(6, 182, 212, 0.2);
    }

    .btn-physics-constant {
      background: rgba(217, 70, 239, 0.15);
      color: #f5d0fe;
      border-color: rgba(217, 70, 239, 0.3);
      font-size: 0.95rem;
    }

    .btn-physics-constant:hover {
      background: rgba(217, 70, 239, 0.3);
      box-shadow: 0 0 12px rgba(217, 70, 239, 0.4);
    }

    .btn-equals {
      background: linear-gradient(135deg, var(--accent-cyan), var(--physics-color));
      color: #fff;
      border: none;
      grid-column: span 2;
      box-shadow: 0 4px 20px rgba(217, 70, 239, 0.3);
    }

    .btn-clear {
      background: rgba(239, 68, 68, 0.2);
      color: #fca5a5;
      border-color: rgba(239, 68, 68, 0.3);
    }

    /* Physics Section Header & Solvers */
    .physics-header {
      background: linear-gradient(135deg, rgba(217, 70, 239, 0.15), rgba(168, 85, 247, 0.05));
      border: 1px solid rgba(217, 70, 239, 0.3);
      border-radius: 16px;
      padding: 16px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .physics-header-title {
      font-weight: 700;
      color: #f5d0fe;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .physics-solvers-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
      margin-top: 20px;
    }

    .solver-card {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(217, 70, 239, 0.25);
      border-radius: 16px;
      padding: 16px;
    }

    .solver-card h4 {
      color: #f5d0fe;
      font-size: 1rem;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
    }

    .solver-inputs {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 12px;
    }

    .solver-input-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .solver-input-group label {
      font-size: 0.85rem;
      color: var(--text-muted);
      width: 70px;
    }

    .solver-input-group input {
      flex: 1;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 8px 12px;
      color: #fff;
      outline: none;
    }

    .solver-btn {
      width: 100%;
      padding: 10px;
      border-radius: 10px;
      background: rgba(217, 70, 239, 0.2);
      border: 1px solid rgba(217, 70, 239, 0.4);
      color: #f5d0fe;
      font-weight: 600;
      cursor: pointer;
    }

    .solver-btn:hover {
      background: rgba(217, 70, 239, 0.35);
    }

    .solver-result {
      margin-top: 10px;
      font-weight: 700;
      color: var(--accent-cyan);
      font-size: 0.95rem;
      text-align: right;
    }

    /* CS Section Styling */
    .cs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
    }

    .cs-card {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(59, 130, 246, 0.25);
      border-radius: 16px;
      padding: 18px;
    }

    .cs-card h3 {
      color: #93c5fd;
      font-size: 1.1rem;
      margin-bottom: 14px;
    }

    .bit-matrix {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 6px;
      margin-bottom: 12px;
    }

    .bit-btn {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: var(--text-muted);
      padding: 8px 0;
      border-radius: 6px;
      font-family: monospace;
      font-size: 0.9rem;
      text-align: center;
      cursor: pointer;
    }

    .bit-btn.active {
      background: rgba(59, 130, 246, 0.3);
      border-color: var(--cs-color);
      color: #fff;
      font-weight: 700;
    }

    /* Unit Converter UI */
    .converter-controls {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group label {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    select, input[type="text"], input[type="number"], textarea {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 12px 16px;
      color: #fff;
      font-size: 1rem;
      outline: none;
      transition: border 0.2s;
    }

    select:focus, input:focus, textarea:focus {
      border-color: var(--accent-cyan);
    }

    .unit-grid-overview {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 10px;
      max-height: 250px;
      overflow-y: auto;
      padding-right: 6px;
      margin-top: 16px;
    }

    .unit-grid-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 10px;
      padding: 10px 12px;
    }

    .unit-grid-item .unit-name {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .unit-grid-item .unit-val {
      font-size: 0.95rem;
      font-weight: 600;
      color: #fff;
      margin-top: 2px;
      word-break: break-all;
    }

    /* Sign-In Gate Overlay */
    #auth-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(7, 9, 19, 0.85);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .auth-card {
      width: 100%;
      max-width: 420px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 25px 50px rgba(0,0,0,0.8);
      text-align: center;
    }

    .auth-card h2 {
      font-size: 1.6rem;
      margin-bottom: 8px;
      background: linear-gradient(135deg, var(--accent-cyan), var(--physics-color));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .auth-card p {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 24px;
    }

    .auth-card input {
      width: 100%;
      margin-bottom: 16px;
      text-align: center;
    }

    .btn-primary {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: none;
      background: linear-gradient(135deg, var(--accent-cyan), var(--physics-color));
      color: #fff;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(6, 182, 212, 0.4);
    }

    .btn-primary:hover {
      opacity: 0.95;
      transform: translateY(-1px);
    }

    /* Modal / Drawer */
    .modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(8px);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-card {
      background: rgba(15, 23, 42, 0.95);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      width: 100%;
      max-width: 500px;
      padding: 24px;
      position: relative;
    }

    .modal-close {
      position: absolute;
      top: 16px;
      right: 16px;
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 1.4rem;
      cursor: pointer;
    }

    .history-drawer {
      position: fixed;
      top: 0;
      right: -380px;
      width: 360px;
      height: 100vh;
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(20px);
      border-left: 1px solid var(--card-border);
      z-index: 2000;
      transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 24px;
      display: flex;
      flex-direction: column;
    }

    .history-drawer.open {
      right: 0;
    }

    .history-list {
      flex: 1;
      overflow-y: auto;
      margin-top: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .history-item {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 12px;
      cursor: pointer;
    }

    .history-item:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    @media (max-width: 640px) {
      .calc-grid { grid-template-columns: repeat(4, 1fr); }
      .converter-controls { grid-template-columns: 1fr; }
      .history-drawer { width: 100%; right: -100%; }
    }
  </style>
</head>
<body>

  <!-- Cosmic Particle & Fluid Background Canvas -->
  <canvas id="bg-canvas"></canvas>

  <!-- Local Sign-In Gate Overlay -->
  <div id="auth-overlay">
    <div class="auth-card">
      <h2>Welcome to MultiCalc</h2>
      <p>Enter your email address to unlock session access. No data is recorded or sent externally.</p>
      <input type="email" id="auth-email-input" placeholder="user@domain.com" required>
      <button class="btn-primary" onclick="handleSignIn()">Sign In & Unlock</button>
    </div>
  </div>

  <!-- Main Web Application -->
  <div class="app-container">
    <header>
      <div class="brand">
        <span class="brand-title">MultiCalc Universal</span>
        <span class="author-tag" id="display-creator">By: Creator Name</span>
      </div>
      <div class="header-actions">
        <button class="btn-icon btn-complain" onclick="openModal('complain-modal')">⚠️ Complain</button>
        <button class="btn-icon" onclick="toggleHistoryDrawer()">📜 History</button>
        <button class="btn-icon" onclick="openModal('settings-modal')">⚙️</button>
      </div>
    </header>

    <!-- Navigation Bar -->
    <nav class="tab-nav">
      <button class="tab-btn active" data-tab="standard" onclick="switchTab('standard')">Standard</button>
      <button class="tab-btn" data-tab="physics" onclick="switchTab('physics')">⚛️ Physics</button>
      <button class="tab-btn" data-tab="cs" onclick="switchTab('cs')">💻 Computer Science</button>
      <button class="tab-btn" data-tab="unit" onclick="switchTab('unit')">📏 Unit Converter</button>
      <button class="tab-btn" data-tab="finance" onclick="switchTab('finance')">💰 Finance & Health</button>
    </nav>

    <!-- TAB 1: STANDARD CALCULATOR -->
    <div id="panel-standard" class="tab-panel active">
      <div class="calc-screen">
        <div class="calc-history-text" id="std-history"></div>
        <div class="calc-main-text" id="std-display">0</div>
      </div>
      <div class="calc-grid">
        <button class="btn-calc btn-clear" onclick="calcInput('AC')">AC</button>
        <button class="btn-calc" onclick="calcInput('DEL')">DEL</button>
        <button class="btn-calc btn-op" onclick="calcInput('%')">%</button>
        <button class="btn-calc btn-op" onclick="calcInput('÷')">÷</button>
        <button class="btn-calc btn-op" onclick="calcInput('×')">×</button>

        <button class="btn-calc" onclick="calcInput('7')">7</button>
        <button class="btn-calc" onclick="calcInput('8')">8</button>
        <button class="btn-calc" onclick="calcInput('9')">9</button>
        <button class="btn-calc btn-op" onclick="calcInput('-')">-</button>
        <button class="btn-calc btn-op" onclick="calcInput('x²')">x²</button>

        <button class="btn-calc" onclick="calcInput('4')">4</button>
        <button class="btn-calc" onclick="calcInput('5')">5</button>
        <button class="btn-calc" onclick="calcInput('6')">6</button>
        <button class="btn-calc btn-op" onclick="calcInput('+')">+</button>
        <button class="btn-calc btn-op" onclick="calcInput('√')">√</button>

        <button class="btn-calc" onclick="calcInput('1')">1</button>
        <button class="btn-calc" onclick="calcInput('2')">2</button>
        <button class="btn-calc" onclick="calcInput('3')">3</button>
        <button class="btn-calc btn-equals" onclick="calcInput('=')">=</button>

        <button class="btn-calc" onclick="calcInput('0')">0</button>
        <button class="btn-calc" onclick="calcInput('.')">.</button>
        <button class="btn-calc" onclick="calcInput('±')">±</button>
      </div>
    </div>

    <!-- TAB 2: PHYSICS (Renamed from Scientific, styled with Electric Violet) -->
    <div id="panel-physics" class="tab-panel">
      <div class="physics-header">
        <div class="physics-header-title">
          <span>⚛️ Physics & Quantum Constants Suite</span>
        </div>
        <div>
          <button class="btn-icon" id="angle-mode-btn" onclick="toggleAngleMode()">DEG</button>
        </div>
      </div>

      <div class="calc-screen">
        <div class="calc-history-text" id="physics-history"></div>
        <div class="calc-main-text" id="physics-display">0</div>
      </div>

      <!-- Quick Constants Toolbar -->
      <div style="display: flex; gap: 6px; overflow-x: auto; margin-bottom: 12px; padding-bottom: 4px;">
        <button class="btn-calc btn-physics-constant" onclick="insertConstant('c')" title="Speed of Light (2.998e8 m/s)">c</button>
        <button class="btn-calc btn-physics-constant" onclick="insertConstant('g')" title="Standard Gravity (9.807 m/s²)">g</button>
        <button class="btn-calc btn-physics-constant" onclick="insertConstant('h')" title="Planck Constant (6.626e-34 J s)">h</button>
        <button class="btn-calc btn-physics-constant" onclick="insertConstant('G')" title="Gravitational Constant (6.674e-11)">G</button>
        <button class="btn-calc btn-physics-constant" onclick="insertConstant('k_B')" title="Boltzmann Constant (1.381e-23 J/K)">k_B</button>
        <button class="btn-calc btn-physics-constant" onclick="insertConstant('e')" title="Elementary Charge (1.602e-19 C)">e⁻</button>
        <button class="btn-calc btn-physics-constant" onclick="insertConstant('N_A')" title="Avogadro Constant (6.022e23)">N_A</button>
        <button class="btn-calc btn-physics-constant" onclick="insertConstant('R')" title="Gas Constant (8.314 J/mol K)">R</button>
        <button class="btn-calc btn-physics-constant" onclick="insertConstant('eps0')" title="Vacuum Permittivity">ε₀</button>
        <button class="btn-calc btn-physics-constant" onclick="insertConstant('mu0')" title="Vacuum Permeability">μ₀</button>
      </div>

      <div class="calc-grid">
        <button class="btn-calc btn-op" onclick="calcInput('sin')">sin</button>
        <button class="btn-calc btn-op" onclick="calcInput('cos')">cos</button>
        <button class="btn-calc btn-op" onclick="calcInput('tan')">tan</button>
