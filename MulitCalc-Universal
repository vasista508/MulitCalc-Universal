  <script>
    /* ====================================================================
       1. SECURITY, PROTECTION & ACCESS GATE LOGIC
       ==================================================================== */
    
    // Check local session on boot
    window.addEventListener('DOMContentLoaded', () => {
      const session = localStorage.getItem('multicalc_signed_in');
      if (session === 'true') {
        document.getElementById('auth-overlay').style.display = 'none';
      }
      loadSettings();
      initCanvas();
      initBitMatrix();
      initUnitConverter();
      renderHistory();
    });

    function handleSignIn() {
      const email = document.getElementById('auth-email-input').value.trim();
      if (email.includes('@') && email.includes('.')) {
        localStorage.setItem('multicalc_signed_in', 'true');
        document.getElementById('auth-overlay').style.display = 'none';
      } else {
        alert('Please enter a valid email address.');
      }
    }

    function handleSignOut() {
      localStorage.removeItem('multicalc_signed_in');
      closeModal('settings-modal');
      document.getElementById('auth-overlay').style.display = 'flex';
    }

    // Frontend Protection Systems
    document.addEventListener('contextmenu', (e) => e.preventDefault());

    document.addEventListener('keydown', (e) => {
      // Block dev tools shortcuts
      if (
        e.key === 'F12' ||
        (e.ctrlKey && e.shiftKey && (e.key === 'I' || e.key === 'J' || e.key === 'C')) ||
        (e.ctrlKey && (e.key === 'u' || e.key === 'U' || e.key === 's' || e.key === 'S'))
      ) {
        e.preventDefault();
        return false;
      }

      // Keyboard routing for active input vs calculator
      if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') {
        return;
      }

      // Numpad & Standard keys mapping
      if (!isNaN(e.key) || e.key === '.') calcInput(e.key);
      else if (e.key === '+') calcInput('+');
      else if (e.key === '-') calcInput('-');
      else if (e.key === '*') calcInput('×');
      else if (e.key === '/') calcInput('÷');
      else if (e.key === 'Enter' || e.key === '=') calcInput('=');
      else if (e.key === 'Backspace') calcInput('DEL');
      else if (e.key === 'Escape') calcInput('AC');
    });

    // Anti-Debug Execution Loop
    setInterval(() => {
      const t0 = performance.now();
      (function(){ return false; }).constructor("debugger")();
      const t1 = performance.now();
      if (t1 - t0 > 100) {
        console.warn("DevTools inspection detected.");
      }
    }, 1000);


    /* ====================================================================
       2. CANVAS ANIMATION ENGINE
       ==================================================================== */
    function initCanvas() {
      const canvas = document.getElementById('bg-canvas');
      const ctx = canvas.getContext('2d');
      let w = canvas.width = window.innerWidth;
      let h = canvas.height = window.innerHeight;

      window.addEventListener('resize', () => {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
      });

      const particles = Array.from({ length: 45 }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 3 + 1,
        dx: (Math.random() - 0.5) * 0.5,
        dy: (Math.random() - 0.5) * 0.5,
        color: ['#06b6d4', '#d946ef', '#a855f7'][Math.floor(Math.random() * 3)]
      }));

      function animate() {
        ctx.fillStyle = 'rgba(7, 9, 19, 0.2)';
        ctx.fillRect(0, 0, w, h);

        particles.forEach(p => {
          p.x += p.dx;
          p.y += p.dy;
          if (p.x < 0 || p.x > w) p.dx *= -1;
          if (p.y < 0 || p.y > h) p.dy *= -1;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = p.color;
          ctx.shadowBlur = 10;
          ctx.shadowColor = p.color;
          ctx.fill();
        });

        requestAnimationFrame(animate);
      }
      animate();
    }


    /* ====================================================================
       3. CALCULATOR & MATHEMATICAL ENGINE
       ==================================================================== */
    let currentTab = 'standard';
    let isDegreeMode = true;
    let calcState = {
      expression: '',
      history: ''
    };

    const PHYSICS_CONSTANTS = {
      c: 299792458,
      g: 9.80665,
      h: 6.62607015e-34,
      G: 6.67430e-11,
      k_B: 1.380649e-23,
      e: 1.602176634e-19,
      N_A: 6.02214076e23,
      R: 8.314462618,
      eps0: 8.8541878128e-12,
      mu0: 1.25663706212e-6
    };

    function switchTab(tabId) {
      currentTab = tabId;
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));

      document.querySelector(`[data-tab="${tabId}"]`).classList.add('active');
      document.getElementById(`panel-${tabId}`).classList.add('active');
    }

    function toggleAngleMode() {
      isDegreeMode = !isDegreeMode;
      document.getElementById('angle-mode-btn').innerText = isDegreeMode ? 'DEG' : 'RAD';
    }

    function insertConstant(constKey) {
      if (PHYSICS_CONSTANTS[constKey] !== undefined) {
        calcState.expression += PHYSICS_CONSTANTS[constKey];
        updateDisplay();
      }
    }

    function calcInput(val) {
      if (val === 'AC') {
        calcState.expression = '';
        calcState.history = '';
      } else if (val === 'DEL') {
        calcState.expression = calcState.expression.slice(0, -1);
      } else if (val === '=') {
        if (!calcState.expression) return;
        try {
          const res = safeEval(calcState.expression);
          saveToHistory(calcState.expression + ' = ' + res);
          calcState.history = calcState.expression + ' =';
          calcState.expression = String(res);
        } catch (err) {
          calcState.expression = 'Error';
        }
      } else if (val === 'x²') {
        calcState.expression += '^2';
      } else if (val === '√') {
        calcState.expression += 'sqrt(';
      } else if (val === 'x^y') {
        calcState.expression += '^';
      } else {
        calcState.expression += val;
      }
      updateDisplay();
    }

    function safeEval(expr) {
      // Expression Sanitize & Parsing
      let parsed = expr
        .replace(/×/g, '*')
        .replace(/÷/g, '/')
        .replace(/π/g, 'Math.PI')
        .replace(/ℯ/g, 'Math.E');

      // Functions mapping
      parsed = parsed.replace(/sqrt\(/g, 'Math.sqrt(');
      parsed = parsed.replace(/log\(/g, 'Math.log10(');
      parsed = parsed.replace(/ln\(/g, 'Math.log(');

      // Trigonometry with DEG / RAD handling
      if (isDegreeMode) {
        parsed = parsed.replace(/sin\(([^)]+)\)/g, 'Math.sin(($1)*Math.PI/180)');
        parsed = parsed.replace(/cos\(([^)]+)\)/g, 'Math.cos(($1)*Math.PI/180)');
        parsed = parsed.replace(/tan\(([^)]+)\)/g, 'Math.tan(($1)*Math.PI/180)');
      } else {
        parsed = parsed.replace(/sin\(/g, 'Math.sin(');
        parsed = parsed.replace(/cos\(/g, 'Math.cos(');
        parsed = parsed.replace(/tan\(/g, 'Math.tan(');
      }

      // Exponents and Factorials
      parsed = parsed.replace(/\^/g, '**');

      // Evaluate safely
      const fn = new Function(`return ${parsed}`);
      const val = fn();
      return Number.isInteger(val) ? val : parseFloat(val.toFixed(8));
    }

    function updateDisplay() {
      const dispId = currentTab === 'physics' ? 'physics-display' : 'std-display';
      const histId = currentTab === 'physics' ? 'physics-history' : 'std-history';

      document.getElementById(dispId).innerText = calcState.expression || '0';
      document.getElementById(histId).innerText = calcState.history || '';
    }


    /* ====================================================================
       4. PHYSICS SOLVERS LOGIC
       ==================================================================== */
    function solveKineticEnergy() {
      const m = parseFloat(document.getElementById('ke-m').value) || 0;
      const v = parseFloat(document.getElementById('ke-v').value) || 0;
      const res = 0.5 * m * v * v;
      document.getElementById('ke-res').innerText = res.toFixed(2) + ' J';
    }

    function solveForce() {
      const m = parseFloat(document.getElementById('f-m').value) || 0;
      const a = parseFloat(document.getElementById('f-a').value) || 0;
      const res = m * a;
      document.getElementById('f-res').innerText = res.toFixed(2) + ' N';
    }

    function solveOhmsLaw() {
      const i = parseFloat(document.getElementById('ohm-i').value) || 0;
      const r = parseFloat(document.getElementById('ohm-r').value) || 0;
      const res = i * r;
      document.getElementById('ohm-res').innerText = res.toFixed(2) + ' V';
    }


    /* ====================================================================
       5. COMPUTER SCIENCE ENGINE
       ==================================================================== */
    let bitRegister = 0;

    function initBitMatrix() {
      const container = document.getElementById('bit-matrix-container');
      container.innerHTML = '';
      for (let i = 31; i >= 0; i--) {
        const btn = document.createElement('button');
        btn.className = 'bit-btn';
        btn.innerText = '0';
        btn.id = `bit-${i}`;
        btn.onclick = () => toggleBit(i);
        container.appendChild(btn);
      }
    }

    function toggleBit(index) {
      bitRegister ^= (1 << index);
      updateBitMatrixUI();
    }

    function updateBitMatrixUI() {
      const unsignedVal = bitRegister >>> 0;
      for (let i = 0; i < 32; i++) {
        const bit = (unsignedVal >> i) & 1;
        const btn = document.getElementById(`bit-${i}`);
        if (btn) {
          btn.innerText = bit;
          btn.classList.toggle('active', bit === 1);
        }
      }

      document.getElementById('bit-dec-val').innerText = unsignedVal;
      document.getElementById('bit-hex-val').innerText = '0x' + unsignedVal.toString(16).toUpperCase().padStart(8, '0');
      document.getElementById('bit-bin-val').innerText = unsignedVal.toString(2).padStart(32, '0').match(/.{1,8}/g).join(' ');
    }

    function convertBases(source) {
      let val = 0;
      if (source === 'dec') val = parseInt(document.getElementById('cs-dec').value, 10) || 0;
      if (source === 'hex') val = parseInt(document.getElementById('cs-hex').value, 16) || 0;
      if (source === 'bin') val = parseInt(document.getElementById('cs-bin').value, 2) || 0;
      if (source === 'oct') val = parseInt(document.getElementById('cs-oct').value, 8) || 0;

      if (source !== 'dec') document.getElementById('cs-dec').value = val.toString(10);
      if (source !== 'hex') document.getElementById('cs-hex').value = val.toString(16).toUpperCase();
      if (source !== 'bin') document.getElementById('cs-bin').value = val.toString(2);
      if (source !== 'oct') document.getElementById('cs-oct').value = val.toString(8);

      bitRegister = val;
      updateBitMatrixUI();
    }

    function calcSubnet() {
      const str = document.getElementById('subnet-ip').value.trim();
      const [ip, cidrStr] = str.split('/');
      const cidr = parseInt(cidrStr, 10) || 24;

      const mask = ~(Math.pow(2, 32 - cidr) - 1) >>> 0;
      const maskArr = [(mask>>>24)&255, (mask>>>16)&255, (mask>>>8)&255, mask&255];
      const usable = Math.pow(2, 32 - cidr) - 2;

      document.getElementById('subnet-res').innerHTML = `
        <div>Subnet Mask: <strong style="color: var(--cs-color);">${maskArr.join('.')}</strong></div>
        <div>Network IP: <strong style="color: var(--cs-color);">${ip.split('.').slice(0,3).join('.')}.0</strong></div>
        <div>Usable Hosts: <strong style="color: var(--accent-cyan);">${usable > 0 ? usable : 0}</strong></div>
      `;
    }


    /* ====================================================================
       6. UNIVERSAL 14-CATEGORY UNIT CONVERTER
       ==================================================================== */
    const UNIT_DATA = {
      length: { name: 'Length', units: { m: 1, km: 1000, cm: 0.01, mm: 0.001, mi: 1609.344, yd: 0.9144, ft: 0.3048, in: 0.0254 } },
      mass: { name: 'Mass / Weight', units: { kg: 1, g: 0.001, mg: 0.000001, lb: 0.453592, oz: 0.0283495, tonne: 1000 } },
      temp: { name: 'Temperature', custom: true },
      volume: { name: 'Volume', units: { l: 1, ml: 0.001, m3: 1000, gal: 3.78541, qt: 0.946353 } },
      area: { name: 'Area', units: { m2: 1, km2: 1000000, ha: 10000, acre: 4046.86, ft2: 0.092903 } },
      speed: { name: 'Speed', units: { m_s: 1, km_h: 0.277778, mph: 0.44704, knot: 0.514444 } },
      time: { name: 'Time', units: { s: 1, min: 60, h: 3600, day: 86400, yr: 31536000 } },
      data: { name: 'Data Storage', units: { B: 1, KB: 1024, MB: 1048576, GB: 1073741824, TB: 1099511627776 } }
    };

    function initUnitConverter() {
      const catSelect = document.getElementById('unit-category');
      catSelect.innerHTML = '';
      for (let key in UNIT_DATA) {
        const opt = document.createElement('option');
        opt.value = key;
        opt.innerText = UNIT_DATA[key].name;
        catSelect.appendChild(opt);
      }
      populateUnitDropdowns();
    }

    function populateUnitDropdowns() {
      const catKey = document.getElementById('unit-category').value;
      const fromSel = document.getElementById('unit-from');
      const toSel = document.getElementById('unit-to');

      fromSel.innerHTML = '';
      toSel.innerHTML = '';

      if (catKey === 'temp') {
        ['Celsius', 'Fahrenheit', 'Kelvin'].forEach(u => {
          fromSel.appendChild(new Option(u, u));
          toSel.appendChild(new Option(u, u));
        });
        toSel.selectedIndex = 1;
      } else {
        const units = UNIT_DATA[catKey].units;
        let idx = 0;
        for (let u in units) {
          fromSel.appendChild(new Option(u, u));
          toSel.appendChild(new Option(u, u));
          if (idx === 1) toSel.selectedIndex = 1;
          idx++;
        }
      }
      convertUnits();
    }

    function convertUnits() {
      const catKey = document.getElementById('unit-category').value;
      const val = parseFloat(document.getElementById('unit-input-val').value) || 0;
      const from = document.getElementById('unit-from').value;
      const to = document.getElementById('unit-to').value;

      let result = 0;

      if (catKey === 'temp') {
        result = convertTemperature(val, from, to);
      } else {
        const units = UNIT_DATA[catKey].units;
        const baseVal = val * units[from];
        result = baseVal / units[to];
      }

      document.getElementById('unit-result-val').innerText = `${val} ${from} = ${result.toFixed(4)} ${to}`;
      renderUnitGrid(catKey, val, from);
    }

    function convertTemperature(val, from, to) {
      if (from === to) return val;
      let c = val;
      if (from === 'Fahrenheit') c = (val - 32) * 5 / 9;
      if (from === 'Kelvin') c = val - 273.15;

      if (to === 'Fahrenheit') return (c * 9 / 5) + 32;
      if (to === 'Kelvin') return c + 273.15;
      return c;
    }

    function renderUnitGrid(catKey, val, from) {
      const grid = document.getElementById('unit-grid-overview');
      grid.innerHTML = '';

      if (catKey === 'temp') return;

      const units = UNIT_DATA[catKey].units;
      const baseVal = val * units[from];

      for (let u in units) {
        const converted = baseVal / units[u];
        const card = document.createElement('div');
        card.className = 'unit-grid-item';
        card.innerHTML = `<div class="unit-name">${u}</div><div class="unit-val">${converted.toFixed(3)}</div>`;
        grid.appendChild(card);
      }
    }

    function handleSmartQuery() {
      const q = document.getElementById('unit-smart-query').value.toLowerCase().trim();
      const match = q.match(/^([\d.]+)\s*([a-z]+)\s*(?:to|in)\s*([a-z]+)$/i);
      if (match) {
        const [_, num, fromUnit, toUnit] = match;
        document.getElementById('unit-input-val').value = num;
        convertUnits();
      }
    }


    /* ====================================================================
       7. FINANCIAL & HEALTH ENGINE
       ==================================================================== */
    function calcLoanEMI() {
      const p = parseFloat(document.getElementById('loan-amount').value) || 0;
      const r = (parseFloat(document.getElementById('loan-rate').value) || 0) / 12 / 100;
      const n = (parseFloat(document.getElementById('loan-years').value) || 0) * 12;

      const emi = (p * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
      document.getElementById('loan-emi-res').innerText = `EMI: $${emi.toFixed(2)} / mo`;
    }

    function calcTip() {
      const bill = parseFloat(document.getElementById('tip-bill').value) || 0;
      const tipPct = parseFloat(document.getElementById('tip-pct').value) || 0;
      const people = parseInt(document.getElementById('tip-people').value, 10) || 1;

      const total = bill * (1 + tipPct / 100);
      const share = total / people;
      document.getElementById('tip-res').innerText = `$${share.toFixed(2)} / person`;
    }

    function calcBMI() {
      const w = parseFloat(document.getElementById('bmi-weight').value) || 0;
      const h = (parseFloat(document.getElementById('bmi-height').value) || 0) / 100;

      if (h > 0) {
        const bmi = w / (h * h);
        let status = 'Normal';
        if (bmi < 18.5) status = 'Underweight';
        else if (bmi >= 25) status = 'Overweight';

        document.getElementById('bmi-res').innerText = `BMI: ${bmi.toFixed(2)} (${status})`;
      }
    }


    /* ====================================================================
       8. MODALS, COMPLAIN SYSTEM & HISTORY PERSISTENCE
       ==================================================================== */
    function openModal(id) {
      document.getElementById(id).style.display = 'flex';
    }

    function closeModal(id) {
      document.getElementById(id).style.display = 'none';
    }

    function saveSettings() {
      const name = document.getElementById('settings-creator-name').value;
      const email = document.getElementById('settings-creator-email').value;

      localStorage.setItem('multicalc_creator_name', name);
      localStorage.setItem('multicalc_creator_email', email);

      document.getElementById('display-creator').innerText = `By: ${name}`;
      document.getElementById('complain-to-email').value = email;

      closeModal('settings-modal');
    }

    function loadSettings() {
      const name = localStorage.getItem('multicalc_creator_name') || 'Creator Name';
      const email = localStorage.getItem('multicalc_creator_email') || 'support@multicalc.org';

      document.getElementById('settings-creator-name').value = name;
      document.getElementById('settings-creator-email').value = email;
      document.getElementById('display-creator').innerText = `By: ${name}`;
      document.getElementById('complain-to-email').value = email;
    }

    function sendComplaint() {
      const to = document.getElementById('complain-to-email').value;
      const subject = encodeURIComponent(document.getElementById('complain-subject').value);
      const body = encodeURIComponent(document.getElementById('complain-body').value);

      window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
      closeModal('complain-modal');
    }

    function toggleHistoryDrawer() {
      document.getElementById('history-drawer').classList.toggle('open');
    }

    function saveToHistory(entry) {
      let history = JSON.parse(localStorage.getItem('multicalc_history') || '[]');
      history.unshift(entry);
      if (history.length > 30) history.pop();
      localStorage.setItem('multicalc_history', JSON.stringify(history));
      renderHistory();
    }

    function renderHistory() {
      const container = document.getElementById('history-list-container');
      const history = JSON.parse(localStorage.getItem('multicalc_history') || '[]');
      container.innerHTML = history.length ? '' : '<div style="color:var(--text-muted); font-size:0.9rem;">No saved calculations.</div>';

      history.forEach(item => {
        const div = document.createElement('div');
        div.className = 'history-item';
        div.innerText = item;
        div.onclick = () => {
          calcState.expression = item.split('=')[0].trim();
          updateDisplay();
          toggleHistoryDrawer();
        };
        container.appendChild(div);
      });
    }

    function clearHistory() {
      localStorage.removeItem('multicalc_history');
      renderHistory();
    }
  </script>
